*Run mix_cross_circuit.py:

python mix_cross_circuit.py \
  --in_path datasets/CW.npz \
  --out_path datasets/CW_mix_K4_deltat0p01_N1.npz \
  --K 4 \
  --delta_t 0.01 \
  --N_out 1 \
  --N_in 1 \
  --seq_len 5000 \
  --seed 2024



*Add y label for K=1:

python - <<'PY'
import numpy as np
from pathlib import Path

path = Path("datasets") / "CW_mix_K1_deltat0p01_N3.npz"
d = np.load(path, allow_pickle=True)

print("keys before:", d.files)

X = d["X"]
groups = d["groups"]  # shape: (M, 1) for K=1
y_raw = groups[:, 0].astype(np.int64)

classes = np.unique(y_raw)
class_to_new = {c: i for i, c in enumerate(classes)}
y = np.array([class_to_new[c] for c in y_raw], dtype=np.int64)

print("X shape:", X.shape)
print("groups shape:", groups.shape)
print("y shape:", y.shape)
print("num classes:", len(classes), "min y:", y.min(), "max y:", y.max())

# Copy all existing arrays and add y
kwargs = {k: d[k] for k in d.files}
kwargs["y"] = y
kwargs["y_raw"] = y_raw
kwargs["classes"] = classes

np.savez_compressed(path, **kwargs)
print("Saved updated dataset with y to", path)
PY



*Run multipage experiment:
bash run_multipage_experiments.sh CW_mix_K1_deltat0p01_N3
